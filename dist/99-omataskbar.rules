# Start omataskbar when the Touch Bar digitizer appears (tiny-dfr's own rules
# still provide the seat and the /dev/tiny_dfr_* device aliases we bind to).
SUBSYSTEM=="input", ATTR{name}=="Apple Inc. Touch Bar Display Touchpad", TAG+="systemd", ENV{SYSTEMD_WANTS}="omataskbar.service"
SUBSYSTEM=="input", ATTR{name}=="MacBookPro17,1 Touch Bar", TAG+="systemd", ENV{SYSTEMD_WANTS}="omataskbar.service"
SUBSYSTEM=="input", ATTR{name}=="Mac14,7 Touch Bar", TAG+="systemd", ENV{SYSTEMD_WANTS}="omataskbar.service"
